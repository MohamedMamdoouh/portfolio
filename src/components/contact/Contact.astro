---
import Icon from '../shared/Icon.astro';
import SocialLinks from '../shared/SocialLinks.astro';
import { profile } from '../../data/profile';

// Email is split into user/domain parts and never rendered as a contiguous address,
// as a lightweight deterrent to naive scrapers while remaining fully readable/accessible.
const [emailUser, emailDomain] = profile.email.split('@');
---

<section id="contact" class="contact">
  <div class="container">
    <div class="section-intro">
      <p class="eyebrow">Contact</p>
      <h2>Get in Touch</h2>
    </div>

    <div class="contact__row">
      <span class="contact__email" data-email-user={emailUser} data-email-domain={emailDomain}>
        <span>{emailUser}</span><span class="contact__at" aria-hidden="true"></span><span
          class="visually-hidden"
        >
          at
        </span><span>{emailDomain}</span>
      </span>

      <button
        id="copy-email-btn"
        type="button"
        class="btn btn-secondary contact__copy-btn"
        data-user={emailUser}
        data-domain={emailDomain}
      >
        <Icon name="copy" size={14} class="copy-icon" />
        <Icon name="check" size={14} class="check-icon" />
        <span id="copy-email-label">Copy Email</span>
      </button>
      <span id="copy-feedback" role="status" aria-live="polite" class="visually-hidden"></span>
    </div>

    <SocialLinks />
  </div>
</section>

<style>
  .contact {
    padding-block: var(--space-6);
  }

  .contact__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .contact__email {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .contact__at::before {
    content: '@';
  }

  .contact__copy-btn {
    padding: 0.45rem 0.9rem;
    font-size: 0.85rem;
  }

  #copy-email-btn :global(.check-icon) {
    display: none;
    color: var(--color-success);
  }

  #copy-email-btn.copied :global(.copy-icon) {
    display: none;
  }

  #copy-email-btn.copied :global(.check-icon) {
    display: block;
  }
</style>

<script>
  const button = document.getElementById('copy-email-btn');
  const label = document.getElementById('copy-email-label');
  const feedback = document.getElementById('copy-feedback');

  button?.addEventListener('click', async () => {
    const user = button.dataset.user;
    const domain = button.dataset.domain;
    const email = `${user}@${domain}`;

    try {
      await navigator.clipboard.writeText(email);
    } catch {
      // Clipboard API unavailable — fall back silently, feedback still informs the user of intent.
    }

    button.classList.add('copied');
    if (label) label.textContent = 'Copied!';
    if (feedback) feedback.textContent = 'Email address copied to clipboard';

    setTimeout(() => {
      button.classList.remove('copied');
      if (label) label.textContent = 'Copy Email';
    }, 2000);
  });
</script>
