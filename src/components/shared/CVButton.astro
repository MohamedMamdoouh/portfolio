---
import Icon from './Icon.astro';
import { profile } from '../../data/profile';

interface Props {
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { variant = 'secondary', class: className = '' } = Astro.props;
---

<a
  href={profile.cvPath}
  download={profile.cvFileName}
  class:list={['btn', variant === 'primary' ? 'btn-primary' : 'btn-secondary', className]}
>
  <Icon name="download" size={18} />
  <span>Download CV</span>
</a>
