---
// Renders an official brand logo (social platforms & technology logos) from simple-icons.
// Icons are monochrome (controlled via currentColor) to stay consistent with the minimal visual direction.
import * as simpleIcons from 'simple-icons';

interface Props {
  slug: string;
  size?: number;
  class?: string;
}

const { slug, size = 20, class: className = '' } = Astro.props;

function toIconKey(s: string): string {
  return `si${s.charAt(0).toUpperCase()}${s.slice(1)}`;
}

const icon = (simpleIcons as unknown as Record<string, { path: string; title: string }>)[
  toIconKey(slug)
];
---

{
  icon && (
    <svg
      viewBox="0 0 24 24"
      width={size}
      height={size}
      role="img"
      aria-hidden="true"
      focusable="false"
      class={className}
    >
      <path d={icon.path} fill="currentColor" />
    </svg>
  )
}
