---
import BrandIcon from './BrandIcon.astro';
import type { TechItem } from '../../data/projects';

interface Props {
  item: TechItem;
}

const { item } = Astro.props;
---

<span class="tech-chip">
  {item.iconSlug && <BrandIcon slug={item.iconSlug} size={16} />}
  <span>{item.name}</span>
</span>

<style>
  .tech-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.4rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text);
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .tech-chip :global(svg) {
    color: var(--color-text-muted);
    flex-shrink: 0;
  }
</style>
