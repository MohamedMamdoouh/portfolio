---
// "MM" monogram mark used as the site logo (nav brand).
interface Props {
  size?: number;
  class?: string;
}

const { size = 36, class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 40 40"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
  class={className}
>
  <rect
    x="1.5"
    y="1.5"
    width="37"
    height="37"
    rx="11"
    fill="none"
    stroke="var(--color-accent)"
    stroke-width="2"></rect>
  <path
    d="M11 27V13h3.1l5.4 8.4L24.9 13H28v14h-3.2v-9.1l-4.7 7.2h-1.4l-4.7-7.2V27H11Z"
    fill="var(--color-text)"></path>
</svg>
