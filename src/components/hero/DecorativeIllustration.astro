---
// Subtle abstract decorative illustration (engineering/connection geometry). Purely decorative.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class:list={['decorative-illustration', className]}
  viewBox="0 0 400 400"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="80" cy="90" r="4" fill="var(--color-accent)"></circle>
  <circle cx="200" cy="50" r="4" fill="var(--color-accent)"></circle>
  <circle cx="330" cy="120" r="4" fill="var(--color-accent)"></circle>
  <circle cx="60" cy="260" r="4" fill="var(--color-accent)"></circle>
  <circle cx="250" cy="330" r="4" fill="var(--color-accent)"></circle>
  <circle cx="360" cy="280" r="4" fill="var(--color-accent)"></circle>
  <circle cx="180" cy="200" r="5" fill="var(--color-accent)"></circle>

  <path
    d="M80 90 L180 200 M200 50 L180 200 M330 120 L180 200 M60 260 L180 200 M250 330 L180 200 M360 280 L180 200 M80 90 L200 50 M330 120 L200 50"
    stroke="var(--color-accent)"
    stroke-width="1"
    stroke-linecap="round"></path>
</svg>

<style>
  .decorative-illustration {
    width: 100%;
    height: 100%;
    opacity: 0.18;
  }

  :root[data-theme='dark'] .decorative-illustration {
    opacity: 0.28;
  }
</style>
