---
import ProjectFeature from './ProjectFeature.astro';
import { projects } from '../../data/projects';

const orderedProjects = [...projects].sort((a, b) => a.order - b.order);
---

<section id="projects" class="projects">
  <div class="container">
    <div class="section-intro">
      <p class="eyebrow">Projects</p>
      <h2>Selected Work</h2>
      <p class="text-muted">
        A closer look at two full-stack systems I designed and built end-to-end — from clean,
        well-tested backend architecture with ASP.NET Core to the Angular interfaces on top of them.
      </p>
    </div>

    {
      orderedProjects.map((project, i) => (
        <ProjectFeature project={project} index={i + 1} reversed={i % 2 === 1} />
      ))
    }
  </div>
</section>

<style>
  .projects {
    padding-block: var(--space-8);
  }
</style>
