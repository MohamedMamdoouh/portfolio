---
import TechChip from '../shared/TechChip.astro';
import Icon from '../shared/Icon.astro';
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const displayIndex = String(index).padStart(2, '0');
---

<article class="project">
  <div class="project__body">
    <span class="project__index" aria-hidden="true">{displayIndex}</span>
    <h3>{project.name}</h3>
    <p class="project__tagline">{project.tagline}</p>
    <p>{project.description}</p>

    <dl class="project__meta">
      <div>
        <dt>Problem it solves</dt>
        <dd>{project.problem}</dd>
      </div>
      <div>
        <dt>Role</dt>
        <dd>{project.role}</dd>
      </div>
    </dl>

    <ul class="project__highlights">
      {project.highlights.map((highlight) => <li>{highlight}</li>)}
    </ul>

    <div class="project__tech-grid">
      {project.technologies.map((tech) => <TechChip item={tech} />)}
    </div>

    <div class="project__actions">
      {
        project.liveUrl ? (
          <>
            <a
              href={project.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              Live Demo
              <Icon name="external-link" size={16} />
            </a>
            <a
              href={project.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary"
            >
              GitHub
            </a>
          </>
        ) : (
          <a
            href={project.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            GitHub
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .project {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .project:first-child {
    border-top: none;
  }

  .project__index {
    display: block;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .project__tagline {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .project__body p {
    margin-top: var(--space-2);
  }

  .project__meta {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-5) 0 0;
  }

  .project__meta dt {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .project__meta dd {
    margin: var(--space-1) 0 0;
  }

  .project__highlights {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .project__highlights li {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius-full);
  }

  .project__tech-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .project__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
</style>
